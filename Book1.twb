      <aliases enabled='yes' />
      <column caption='Total Work Minutes' datatype='integer' name='[Calculation_0915656886194176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([session_duration_minutes])' />
      </column>
      <column caption='Flow Minutes' datatype='integer' name='[Calculation_0915656886775810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [in_flow_state] = 1 THEN&#13;&#10;        [session_duration_minutes]&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Flow Efficiency %' datatype='real' name='[Calculation_0915656887599107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [in_flow_state] = 1 THEN&#13;&#10;        [session_duration_minutes]&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([session_duration_minutes])' />
      </column>
      <column caption='Context Switches' datatype='integer' name='[Calculation_0915656887832580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([context_switch_flag])' />
      </column>
      <column caption='Context Switch Rate' datatype='real' name='[Calculation_0915656887947269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([context_switch_flag])&#13;&#10;/&#13;&#10;COUNT([log_id])' />
      </column>
      <column caption='Interruption Events' datatype='integer' name='[Calculation_0915656888377350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [interruption_id] &lt;&gt; 0 THEN&#13;&#10;        1&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Avg Recovery Time' datatype='real' name='[Calculation_0915656888451079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([cognitive_recovery_minutes])' />
      </column>
      <column caption='Interrupted Sessions' datatype='integer' name='[Calculation_0915656888508424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [interruption_id] &lt;&gt; 0 THEN&#13;&#10;        [log_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Deep Work Minutes' datatype='integer' name='[Calculation_0915656888594441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [is_deep_work] = 1 THEN&#13;&#10;        [session_duration_minutes]&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Deep Work %' datatype='real' name='[Calculation_0915656888918026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [is_deep_work] = 1 THEN&#13;&#10;        [session_duration_minutes]&#13;&#10;    ELSE&#13;&#10;        0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([session_duration_minutes])' />
      </column>
      <column caption='Total Work Hours' datatype='real' name='[Calculation_0915656889901067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([session_duration_minutes]) / 60' />
      </column>
      <column caption='Total Recovery Hours' datatype='real' name='[Calculation_0915656890335244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cognitive_recovery_minutes]) / 60' />
      </column>
