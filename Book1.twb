  <worksheets>
    <worksheet name='Flow Efficiency Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='clean_fact_developer_activity_log+' name='federated.09ce2ks1l6jnyz168fcgm0dy2mpo' />
          </datasources>
          <datasource-dependencies datasource='federated.09ce2ks1l6jnyz168fcgm0dy2mpo'>
            <column caption='Flow Efficiency %' datatype='real' name='[Calculation_0915656887599107]' role='measure' type='quantitative'>
